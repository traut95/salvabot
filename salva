<script>
"use strict";
const DBKEY="salva_database", SESSION="session";
const rouletteNumbers={
red:new Set([1,3,5,7,9,12,14,16,18,19,21,23,25,27,30,32,34,36]),
black:new Set([2,4,6,8,10,11,13,15,17,20,22,24,26,28,29,31,33,35])
};
const $=s=>document.querySelector(s);
const esc=s=>String(s??"").replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]));
function uid(){return String(Math.floor(100000+Math.random()*900000))}
function now(){return new Date().toISOString()}
function time(v){return new Date(v).toLocaleTimeString("ru-RU",{hour:"2-digit",minute:"2-digit"})}
function dateTime(v){return new Date(v).toLocaleString("ru-RU",{day:"2-digit",month:"2-digit",year:"numeric",hour:"2-digit",minute:"2-digit"})}
function toast(t){let e=$("#toast");e.textContent=t;e.classList.remove("hidden");clearTimeout(toast.t);toast.t=setTimeout(()=>e.classList.add("hidden"),2600)}
function freshDB(){return {users:[],chats:[],messages:[],friends:[],posts:[],stickers:[],settings:{},roulette:{red:45,black:50,zero:5},adminId:null,session:null}}
function db(){try{return JSON.parse(localStorage.getItem(DBKEY))||freshDB()}catch{return freshDB()}}
function save(d){localStorage.setItem(DBKEY,JSON.stringify(d))}
function current(d=db()){return d.users.find(u=>u.id===d.session)||null}
function xpAdd(u,n){u.xp+=n;while(u.xp>=u.xpNext){u.xp-=u.xpNext;u.level++;u.xpNext=Math.round(u.xpNext*1.45)}}
function ensureDB(){
 let d=db();
 if(!d.users)d.users=[];
 d.users.forEach(u=>{
  u.balance=Number.isFinite(Number(u.balance))&&Number(u.balance)>=0?Math.floor(Number(u.balance)):0;
  u.wonCoins=Number.isFinite(Number(u.wonCoins))&&Number(u.wonCoins)>=0?Math.floor(Number(u.wonCoins)):0;
  if(!Number.isFinite(Number(u.xp))||Number(u.xp)<0)u.xp=0;
  if(!Number.isFinite(Number(u.level))||Number(u.level)<1)u.level=1;
  if(!Number.isFinite(Number(u.xpNext))||Number(u.xpNext)<1)u.xpNext=100;
 });
 if(!d.roulette)d.roulette={red:45,black:50,zero:5};
 save(d);return d
}
function avatar(u){return u.avatar?`<img class="avatar" src="${esc(u.avatar)}">`:`<div class="avatar">${esc((u.nickname||"?")[0].toUpperCase())}</div>`}
function findUser(id){return db().users.find(u=>u.id===id)}
function chatFor(a,b){let d=db();return d.chats.find(c=>!c.group&&c.members.includes(a)&&c.members.includes(b))}
function createBotChat(u,d){
 let c={id:crypto.randomUUID(),name:"Game Bot",members:[u.id,"000001"],owner:"000001",bot:true,group:false,createdAt:now()};
 d.chats.push(c);d.messages.push({id:crypto.randomUUID(),chatId:c.id,sender:"000001",type:"text",text:"🎮 Добро пожаловать! Я Game Bot. Напиши «я» или попробуй рулетку.",at:now()});
}
function layout(){
 let u=current(); if(!u){renderAuth();return}
 let view=window.view||"messenger";
 $("#root").innerHTML=`<div class="app">
 <aside class="sidebar"><div class="brand">SALVA</div>
 <div class="me-card"><div class="me-row">${avatar(u)}<div><div class="me-name">${esc(u.nickname)}</div><div class="tiny">ID ${u.id}</div></div></div><div class="balance">💰 $${u.balance.toLocaleString("ru-RU")}</div></div>
 <nav class="nav">
 <button class="${view==="messenger"?"active":""}" onclick="go('messenger')">💬 Мессенджер</button>
 <button class="${view==="friends"?"active":""}" onclick="go('friends')">👥 Друзья</button>
 <button class="${view==="profile"?"active":""}" onclick="go('profile')">👤 Профиль</button>
 ${dB().adminId===u.id?`<button class="${view==="admin"?"active":""}" onclick="go('admin')">🛡️ Админ-панель</button>`:""}
 </nav>
 <button class="btn" style="width:100%;margin-top:20px" onclick="logout()">Выйти</button>
 </aside><main class="main"><div id="view" class="view"></div></main></div>`;
 renderView();
}
function dB(){return ensureDB()}
function go(v){window.view=v;window.selectedChat=null;layout()}
function renderView(){if(window.view==="friends")renderFriends();else if(window.view==="profile")renderProfile(current().id);else if(window.view==="admin")renderAdmin();else renderMessenger()}
function renderMessenger(){
 let d=dB(),u=current(), chats=d.chats.filter(c=>c.members.includes(u.id));
 if(!window.selectedChat||!chats.some(c=>c.id===window.selectedChat))window.selectedChat=chats[0]?.id;
 let c=chats.find(x=>x.id===window.selectedChat);
 $("#view").innerHTML=`<div class="topbar"><div><h1>Мессенджер</h1><div class="sub">Ваши чаты и Game Bot</div></div><button class="btn primary" onclick="newGroup()">＋ Создать чат</button></div>
 <div class="grid chat-layout"><section class="glass chat-list">${chats.map(c=>chatCard(c,d,u)).join("")}</section>
 <section class="glass chat-window">${c?chatWindow(c,d,u):`<div style="margin:auto;color:var(--muted)">Создайте чат или выберите существующий.</div>`}</section></div>`;
 if(c) setTimeout(()=>{let m=$("#messages");m.scrollTop=m.scrollHeight;focusComposer()},0)
}
function chatCard(c,d,u){
 let title=c.bot?"Game Bot":c.group?c.name:(findUser(c.members.find(x=>x!==u.id))?.nickname||"Чат");
 let msgs=d.messages.filter(m=>m.chatId===c.id);let last=msgs.at(-1);
 return `<div class="chat-item ${c.id===window.selectedChat?"active":""}" onclick="selectChat('${c.id}')">${c.bot?"🎮":c.group?"👥":"💬"}<div style="min-width:0"><div class="chat-title">${esc(title)}</div><div class="chat-preview">${esc(last?.text||"Нет сообщений")}</div></div></div>`
}
function chatWindow(c,d,u){
 let title=c.bot?"Game Bot":c.group?c.name:(findUser(c.members.find(x=>x!==u.id))?.nickname||"Чат");
 let msgs=d.messages.filter(m=>m.chatId===c.id);
 return `<div class="chat-head"><div><b>${esc(title)}</b><div class="tiny">${c.members.length} участник(а)</div></div>
 <div><button class="btn" onclick="muteMenu('${c.id}')">🔔</button> <button class="btn" onclick="chatMenu('${c.id}')">⋯</button></div></div>
 <div id="messages" class="messages">${msgs.map(messageHTML).join("")}</div>
 <div class="composer" style="position:relative">
 <div id="emojiPanel" class="emoji-panel hidden">${["😀","😂","❤️","🔥","👍","🎉","😎","😭","💀","🚀","💰","🎮","👀","✨","😈"].map(x=>`<button onclick="insertEmoji('${x}')">${x}</button>`).join("")}</div>
 <div id="stickerPanel" class="sticker-panel hidden">${d.stickers.filter(s=>s.owner===u.id).map(s=>`<button onclick="sendSticker('${esc(s.value)}','${s.kind}')">${s.kind==="emoji"?s.value:"🎟️ "+esc(s.value.slice(0,15))}</button>`).join("")||"<span class='tiny'>Нет своих стикеров</span>"}</div>
 <button class="iconbtn" onclick="togglePanel('emojiPanel')">😊</button><button class="iconbtn" onclick="togglePanel('stickerPanel')">🎟️</button>
 <label class="iconbtn" style="display:grid;place-items:center">📷<input hidden type="file" accept="image/*" onchange="sendImage(event)"></label>
 <textarea id="composerInput" placeholder="Напишите сообщение..." onkeydown="composerKey(event)"></textarea>
 <button class="iconbtn" onclick="sendCurrent()" title="Отправить">➤</button></div>`
}
function messageHTML(m){
 if(m.type==="image")return `<div class="msg ${m.sender===current().id?"mine":""}"><img src="${esc(m.data)}"><div class="meta">${time(m.at)}</div></div>`;
 if(m.type==="sticker")return `<div class="msg ${m.sender===current().id?"mine":""}" style="font-size:42px">${esc(m.text)}<div class="meta">${time(m.at)}</div></div>`;
 let sender=findUser(m.sender),reply="";if(m.replyTo){let original=db().messages.find(x=>x.id===m.replyTo);if(original)reply=`<div class="reply-preview"><b>↩ Ответ на ставку</b><div>${esc(original.text)}</div></div>`}return `<div class="msg ${m.sender===current().id?"mine":""}">${m.sender!==current().id&&sender?`<div class="tiny">${esc(sender.nickname)}</div>`:""}${reply}${esc(m.text)}<div class="meta">${time(m.at)}</div></div>`
}
function selectChat(id){window.selectedChat=id;renderMessenger()}
function composerKey(e){if(e.key==="Enter"&&!e.shiftKey){e.preventDefault();sendCurrent()}}
function focusComposer(){
 setTimeout(()=>{let el=$("#composerInput");if(el){el.focus();let len=el.value.length;try{el.setSelectionRange(len,len)}catch{}}},0);
}
function sendCurrent(){
 let el=$("#composerInput"),text=el.value.trim();if(!text)return;
 sendMessage(window.selectedChat,text);focusComposer()
}
function sendMessage(chatId,text,type="text"){
 let d=dB(),u=current(d);if(!u)return;d.messages.push({id:crypto.randomUUID(),chatId,sender:u.id,type,text,at:now()});xpAdd(u,3);save(d);renderMessenger();
 let c=d.chats.find(x=>x.id===chatId);if(c?.bot)setTimeout(()=>botReply(chatId,text),150)
}
function botReply(chatId,text){
 let d=dB(),u=current();if(!u)return;
 let t=text.trim().toLowerCase(),reply="";
 if(t==="я"||t==="/я")reply=`👤 Имя: ${u.nickname}\n🆔 ID: ${u.id}\n💰 Баланс: $${u.balance.toLocaleString("ru-RU")}\n⭐ Уровень: ${u.level}\n⚡ XP: ${u.xp}/${u.xpNext}\n🏆 Выиграно монет: $${u.wonCoins.toLocaleString("ru-RU")}`;
 else if(parseBet(t)) roulette(chatId,t);
 else reply="🎮 Команды: «я», «/я». Рулетка: «21 100», «черный 100к», «красный 1кк».";
 if(reply){d.messages.push({id:crypto.randomUUID(),chatId,sender:"000001",type:"text",text:reply,at:now()});save(d);if(window.selectedChat===chatId)renderMessenger()}
}
function togglePanel(id){document.querySelectorAll(".emoji-panel,.sticker-panel").forEach(e=>e.id===id?e.classList.toggle("hidden"):e.classList.add("hidden"))}
function insertEmoji(e){let x=$("#composerInput");x.value+=e;x.focus()}
function sendSticker(v){togglePanel("stickerPanel");sendMessage(window.selectedChat,v,"sticker")}
function sendImage(e){let f=e.target.files[0];if(!f)return;if(f.size>5*1024*1024){toast("❌ Изображение больше 5 МБ");return}
 let r=new FileReader();r.onload=()=>{let d=dB(),u=current(d);if(!u)return;d.messages.push({id:crypto.randomUUID(),chatId:window.selectedChat,sender:u.id,type:"image",data:r.result,at:now()});xpAdd(u,3);save(d);renderMessenger()};r.readAsDataURL(f);e.target.value=""
}
function parseAmount(s){
 s=String(s).toLowerCase().replace(/\s/g,"");let m=s.match(/^(\d+(?:[.,]\d+)?)(ккк|kkk|кк|kk|к|k)?$/);if(!m)return NaN;
 let n=Number(m[1].replace(",",".")),x=m[2]||"";let mult=/^(ккк|kkk)$/.test(x)?1e9:/^(кк|kk)$/.test(x)?1e6:/^(к|k)$/.test(x)?1e3:1;let value=n*mult;return Number.isFinite(value)&&value<=Number.MAX_SAFE_INTEGER?value:NaN
}
function parseBet(t){
 let a=t.split(/\s+/);if(a.length!==2)return null;
 let target=a[0],amount=parseAmount(a[1]);if(!Number.isFinite(amount)||amount<=0||amount>1e9)return null;
 if(/^\d+$/.test(target)&&+target>=0&&+target<=36)return {kind:"number",target:+target,amount};
 if(["черный","чёрный","black"].includes(target))return {kind:"color",target:"black",amount};
 if(["красный","red"].includes(target))return {kind:"color",target:"red",amount};
 return null
}
function weightedColor(d){
 let r=Math.max(0,Number(d.roulette.red)||0),b=Math.max(0,Number(d.roulette.black)||0),z=Math.max(0,Number(d.roulette.zero)||0),sum=r+b+z;
 let n=Math.random()*sum;if(n<r)return"red";if(n<r+b)return"black";return"zero"
}
function roulette(chatId,t){
 let bet=parseBet(t),d=dB(),u=current(d);if(!bet||!u)return;
 const userId=u.id;
 if(!Number.isSafeInteger(bet.amount)||bet.amount<=0){toast("Некорректная сумма");return}
 if(u.balance<bet.amount){
  d.messages.push({id:crypto.randomUUID(),chatId,sender:"000001",type:"text",text:"❌ Недостаточно монет для этой ставки.",at:now()});
  save(d);renderMessenger();return
 }
 u.balance-=bet.amount;
 const betMsg={id:crypto.randomUUID(),chatId,sender:userId,type:"text",text:t,at:now()};
 d.messages.push(betMsg);
 const targetText=bet.kind==="number"?`число ${bet.target}`:(bet.target==="red"?"красное":"чёрное");
 const botText=`🎰 Ставка принята!\n💬 ${targetText} — $${bet.amount.toLocaleString("ru-RU")}\n⏳ Колесо уже запущено. Результат будет через 15 секунд. Удачи! 🍀`;
 d.messages.push({id:crypto.randomUUID(),chatId,sender:"000001",type:"text",text:botText,at:now(),replyTo:betMsg.id});
 save(d);renderMessenger();

 setTimeout(()=>{
  let d2=dB(),u2=d2.users.find(x=>x.id===userId);if(!u2)return;
  let color=weightedColor(d2);
  let num=color==="zero"?0:(()=>{let n;do{n=Math.floor(Math.random()*36)+1}while((color==="red"&&!rouletteNumbers.red.has(n))||(color==="black"&&!rouletteNumbers.black.has(n)));return n})();
  let win=0;
  if(bet.kind==="number"&&bet.target===num)win=bet.amount*35;
  else if(bet.kind==="color"&&bet.target===color)win=bet.amount*2;
  if(win){
   u2.balance=Math.min(Number.MAX_SAFE_INTEGER,u2.balance+win);
   u2.wonCoins=Math.min(Number.MAX_SAFE_INTEGER,u2.wonCoins+win);
  }
  xpAdd(u2,10);
  let icon=color==="red"?"🔴":color==="black"?"⚫":"🟢";
  let text=`🎰 Результат: ${icon} ${num}\n${win?`🏆 Вы выиграли $${win.toLocaleString("ru-RU")}!`:`❌ Вы проиграли $${bet.amount.toLocaleString("ru-RU")}.`}\n💰 Баланс: $${u2.balance.toLocaleString("ru-RU")}`;
  d2.messages.push({id:crypto.randomUUID(),chatId,sender:"000001",type:"text",text,at:now()});
  save(d2);
  if(d2.session===userId)renderMessenger();
 },15000);

 setTimeout(()=>{
